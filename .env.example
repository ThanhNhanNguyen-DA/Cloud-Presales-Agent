GROQ_API_KEY=your_groq_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=512
# --- LLM model chains (primary first). Each entry: "provider:model" (groq | gemini | hf) or a
# bare Groq model. Models whose provider key is missing are skipped. Benchmarks: scripts/eval_orchestrator.py
# LLM_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,gemini:gemini-3.5-flash-lite   # agents + general (GROQ_MODELS = old name)
# SUPERVISOR_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-120b   # default (best routing: 100% @ 0.35 s)
# GRADER_MODELS=                                          # defaults to LLM_MODELS
# JUDGE_MODELS=                                           # RAGAS judge (defaults to LLM_MODELS)
# GEMINI_API_KEY=                                         # optional, free tier at aistudio.google.com
# HUGGINGFACEHUB_API_TOKEN=                               # optional (HF router, small free credit)

# --- Retrieval
# HYBRID_SEARCH_ENABLED=true                            # keyword channel requires migration 004
# RERANK_ENABLED=true
# RERANK_MODEL=BAAI/bge-reranker-v2-m3                     # or cross-encoder/mmarco-mMiniLMv2-L12-H384-v1 (4x faster)
# RERANK_MIN_SCORE=0.1                                  # provisional relevance cutoff, NOT 10% confidence
# Calibrate with reviewed positive/negative queries: see docs/retrieval-quality.md

# --- API security (required; the server refuses to start without API_KEYS) ---
# Client keys as "label:key", comma-separated. The UI uses the first one (or PRESALES_API_KEY).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=ui:change-me-to-a-random-key
# Separate key for /admin/feedback (approving or rejecting human corrections).
ADMIN_API_KEY=change-me-to-another-random-key
# Optional:
# CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# RATE_LIMIT_PER_MINUTE=20
# FEEDBACK_RATE_LIMIT_PER_MINUTE=30
# FEEDBACK_AUTO_APPROVE=false     # true = corrections apply without review (local demos only)
# AUTH_DISABLED=false             # true = no keys at all (throwaway local runs only)
# API_BASE_URL=http://localhost:8000   # used by the Streamlit UI
# LOG_LEVEL=INFO
# WARMUP_EMBEDDINGS=true          # load the embedding model at API startup (first request isn't slow)
