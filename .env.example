GROQ_API_KEY=your_groq_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBEDDING_DIM=512
# Optional — ordered Groq fallback chain (primary first). Defaults shown below.
# GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b

# --- API security (required; the server refuses to start without API_KEYS) ---
# Client keys as "label:key", comma-separated. The UI uses the first one (or PRESALES_API_KEY).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=ui:change-me-to-a-random-key
# Separate key for /admin/feedback (approving or rejecting human corrections).
ADMIN_API_KEY=change-me-to-another-random-key
# Optional:
# CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
# RATE_LIMIT_PER_MINUTE=20
# FEEDBACK_RATE_LIMIT_PER_MINUTE=30
# FEEDBACK_AUTO_APPROVE=false     # true = corrections apply without review (local demos only)
# AUTH_DISABLED=false             # true = no keys at all (throwaway local runs only)
# API_BASE_URL=http://localhost:8000   # used by the Streamlit UI
# LOG_LEVEL=INFO
# WARMUP_EMBEDDINGS=true          # load the embedding model at API startup (first request isn't slow)
